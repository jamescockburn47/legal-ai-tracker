{
  "profiles": [
    {
      "id": "solicitor",
      "summary": "Existing professional duties continue to govern AI-assisted work. The SRA's August 2026 warning focuses on unreliable outputs and client confidentiality. A solicitor remains responsible for the work delivered; using AI does not transfer that responsibility to a supplier or supervisor. Individual practitioner responsibilities. Firm governance and COLP duties are separate, overlapping layers.",
      "priorities": [
        {
          "title": "Verify the work",
          "text": "Verify authorities, factual assertions and legal reasoning before relying on AI-assisted work.",
          "sourceUrl": "https://www.sra.org.uk/solicitors/guidance/misuse-ai/"
        },
        {
          "title": "Protect client information",
          "text": "Check the actual contractual and technical safeguards before entering client information; a paid account alone is not assurance.",
          "sourceUrl": "https://www.sra.org.uk/solicitors/guidance/misuse-ai/"
        },
        {
          "title": "Work within supervision arrangements",
          "text": "Follow your firm's supervision and approved-use arrangements, and escalate errors or inappropriate disclosure promptly.",
          "sourceUrl": "https://www.sra.org.uk/solicitors/guidance/misuse-ai/"
        }
      ],
      "sources": [
        {
          "title": "SRA Misuse of AI warning notice",
          "url": "https://www.sra.org.uk/solicitors/guidance/misuse-ai/",
          "locator": "AI hallucinations \u2013 relevant considerations; confidentiality; Summary \u2014 Regulator warning interpreting existing obligations"
        },
        {
          "title": "SRA Effective supervision",
          "url": "https://www.sra.org.uk/solicitors/guidance/effective-supervision-guidance/",
          "locator": "Appropriate supervision arrangements; Ensuring supervision is effective \u2014 Regulatory guidance; expressly not new standards"
        }
      ],
      "checkedAt": "2026-10-21"
    },
    {
      "id": "barrister",
      "summary": "The BSB's May 2026 guidance applies existing Handbook duties to AI use. Personal responsibility, duties to the court and competent service remain central. The guidance also treats AI as outsourcing and addresses risks arising from other people's AI-assisted material. BSB regulatory guidance and Bar Council professional commentary have different status.",
      "priorities": [
        {
          "title": "Personal responsibility",
          "text": "Check outputs before incorporating them into advice or submissions.",
          "sourceUrl": "https://www.barstandardsboard.org.uk/static/5e1baa5c-614c-4105-afae9a9ccdf8d97b/c0d1ed62-fcad-4a68-8ab810de5fa9b116/Artificial-Intelligence-Guidance-May-2026.pdf"
        },
        {
          "title": "Confidentiality and client benefit",
          "text": "Assess confidentiality, competence and client benefit for the proposed use.",
          "sourceUrl": "https://www.barstandardsboard.org.uk/static/5e1baa5c-614c-4105-afae9a9ccdf8d97b/c0d1ed62-fcad-4a68-8ab810de5fa9b116/Artificial-Intelligence-Guidance-May-2026.pdf"
        },
        {
          "title": "Disclosure depends on context",
          "text": "Consider whether disclosure of AI use is required by context, a request, applicable rules or its material effect on the service.",
          "sourceUrl": "https://www.barstandardsboard.org.uk/static/5e1baa5c-614c-4105-afae9a9ccdf8d97b/c0d1ed62-fcad-4a68-8ab810de5fa9b116/Artificial-Intelligence-Guidance-May-2026.pdf"
        }
      ],
      "sources": [
        {
          "title": "BSB Guidance on the use of Artificial Intelligence and Other Technologies",
          "url": "https://www.barstandardsboard.org.uk/static/5e1baa5c-614c-4105-afae9a9ccdf8d97b/c0d1ed62-fcad-4a68-8ab810de5fa9b116/Artificial-Intelligence-Guidance-May-2026.pdf",
          "locator": "Sections 1, 3\u20136; pp2\u20133,7\u201310,12\u201314 \u2014 Regulator guidance explaining existing Handbook duties"
