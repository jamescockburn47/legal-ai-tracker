    {
      "id": "colp",
      "summary": "The COLP's role is firm-wide compliance assurance. Paragraph 9.1 of the Firms Code requires reasonable steps towards the specified compliance and reporting outcomes. AI risks sit within that framework; appointing a COLP does not remove managers' or individual practitioners' responsibilities. Use only for the formally appointed COLP role. The separate COFA responsibilities are not covered by this summary.",
      "priorities": [
        {
          "title": "Assurance and evidence",
          "text": "Check how the firm demonstrates that AI controls and supervision work in practice.",
          "sourceUrl": "https://www.sra.org.uk/solicitors/standards-regulations/code-conduct-firms/"
        },
        {
          "title": "Escalation",
          "text": "Maintain an escalation route for inaccurate outputs, confidentiality incidents and repeated control failures.",
          "sourceUrl": "https://www.sra.org.uk/solicitors/standards-regulations/code-conduct-firms/"
        },
        {
          "title": "Reporting thresholds",
          "text": "Assess reportability under the actual SRA thresholds; an AI incident is not automatically a reportable serious breach.",
          "sourceUrl": "https://www.sra.org.uk/solicitors/standards-regulations/code-conduct-firms/"
        }
      ],
      "sources": [
        {
          "title": "SRA Responsibilities of COLPs and COFAs",
          "url": "https://www.sra.org.uk/solicitors/guidance/responsibilities-of-colps-and-cofas/",
          "locator": "General \u2014 Foundational regulator guidance outside three-year publication window; read with current Code"
        },
        {
          "title": "SRA Code of Conduct for Firms",
          "url": "https://www.sra.org.uk/solicitors/standards-regulations/code-conduct-firms/",
          "locator": "Paragraphs 2.1\u20132.3,4.3\u20134.4,8.1,9.1 \u2014 Current regulator Code page checked; rules"
        },
        {
          "title": "SRA Misuse of AI warning notice",
