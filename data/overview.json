    {
      "id": "firm-compliance",
      "summary": "The firm's governance, records and supervision obligations shape the control programme. A risk or compliance job title does not itself make its holder the COLP. Responsibilities should be allocated between managers, the COLP, supervisors and operational teams. Suggested operational controls, not a regulator-prescribed checklist or a transfer of COLP duties.",
      "priorities": [
        {
          "title": "Tool and supplier controls",
          "text": "Document permitted tools and uses, ownership, supplier review and access controls.",
          "sourceUrl": "https://www.sra.org.uk/solicitors/standards-regulations/code-conduct-firms/"
        },
        {
          "title": "Training and checks",
          "text": "Test whether staff understand when human checks and escalation are needed.",
          "sourceUrl": "https://www.sra.org.uk/solicitors/standards-regulations/code-conduct-firms/"
        },
        {
          "title": "Record decisions",
          "text": "Keep evidence of training, approvals and monitoring proportionate to the risks and the firm's compliance obligations.",
          "sourceUrl": "https://www.sra.org.uk/solicitors/standards-regulations/code-conduct-firms/"
        }
      ],
      "sources": [
        {
          "title": "SRA Code of Conduct for Firms",
          "url": "https://www.sra.org.uk/solicitors/standards-regulations/code-conduct-firms/",
          "locator": "Paragraphs 2.1\u20132.3,4.3\u20134.4,8.1,9.1 \u2014 Current regulator Code page checked; rules"
