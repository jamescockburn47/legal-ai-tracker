    {
      "id": "inhouse",
      "summary": "An employer's AI policy does not displace a solicitor's professional duties. Independence, competence, supervision and confidentiality continue to apply. Identify the client and protect the legal function's information: not every communication involving an in-house solicitor is privileged. This profile addresses SRA-regulated in-house solicitors. Employed barristers should also consult the barrister profile; the employer is not automatically an SRA-regulated firm.",
      "priorities": [
        {
          "title": "Separate legal information",
          "text": "Separate legal advice and restricted matter material from general corporate AI workspaces.",
          "sourceUrl": "https://www.sra.org.uk/solicitors/guidance/understanding-in-house-solicitors-professional-obligations-employer/"
        },
        {
          "title": "Explain professional constraints",
          "text": "Explain professional constraints to business stakeholders before deployment.",
          "sourceUrl": "https://www.sra.org.uk/solicitors/guidance/understanding-in-house-solicitors-professional-obligations-employer/"
        },
        {
          "title": "Check centrally purchased tools",
          "text": "Assess access permissions and supervision within the legal team, including tools procured centrally by the business.",
          "sourceUrl": "https://www.sra.org.uk/solicitors/guidance/understanding-in-house-solicitors-professional-obligations-employer/"
        }
      ],
      "sources": [
        {
          "title": "SRA Understanding in-house solicitors' professional obligations as an employer",
          "url": "https://www.sra.org.uk/solicitors/guidance/understanding-in-house-solicitors-professional-obligations-employer/",
          "locator": "The regulation of solicitors; What you can expect from your regulated in-house solicitors \u2014 Regulator guidance"
        },
        {
          "title": "SRA Misuse of AI warning notice",
          "url": "https://www.sra.org.uk/solicitors/guidance/misuse-ai/",
          "locator": "AI hallucinations \u2013 relevant considerations; confidentiality; Summary \u2014 Regulator warning interpreting existing obligations"
        }
      ],
      "checkedAt": "2026-10-21"
